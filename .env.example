# Copy to .env.local for local work, and set the same names in Vercel > Project > Settings > Environment Variables.
# Without these, `npm run dev` uses a temporary in-memory store (rooms vanish on restart).

# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Secret. Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Used by browsers only to listen for "room changed" pings.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
